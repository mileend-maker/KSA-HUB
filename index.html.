                            <option value="all">All Retailers</option>
                            <option value="hypermarket">Hypermarkets & Supermarkets</option>
                            <option value="electronics">Electronics & Tech</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Supermarket Leaflets Grid -->
            <div id="flyersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                
                <!-- HyperPanda Card -->
