                                <span>Featured Deals:</span>
                                <span class="font-bold text-slate-800">Fresh Produce & Oils</span>
                            </div>
                            <div class="flex items-center justify-between border-b pb-1">
                                <span>Active Pages:</span>
                                <span class="font-bold text-emerald-600">28 Pages Leaflet</span>
                            </div>
                            <p class="text-[11px] text-slate-500 bg-slate-50 p-2 rounded border">Includes 10kg Rice discount, Sunflower Oil 2x1.5L bundle & fresh chicken promo.</p>
                        </div>
                        <button onclick="openLeafletModal('Panda Weekly Mega Deals', 4, 'Panda')" class="w-full bg-slate-900 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Browse Leaflet
                        </button>
                    </div>
                </div>

                <!-- LuLu Hypermarket Card -->
