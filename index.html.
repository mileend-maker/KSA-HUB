                    <div class="relative bg-gradient-to-r from-blue-700 to-indigo-800 p-4 text-white">
                        <span class="absolute top-3 right-3 bg-amber-400 text-slate-900 text-[10px] font-bold px-2 py-0.5 rounded-full shadow">WHOLESALE PRICING</span>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-blue-700 font-extrabold text-lg shadow">
