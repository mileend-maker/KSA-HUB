                        <button onclick="openLeafletModal('Al Othaim Weekly Promotions', 4, 'Othaim')" class="w-full bg-slate-900 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Browse Leaflet
                        </button>
                    </div>
                </div>

                <!-- Nesto Hypermarket Card -->
                <div class="flyer-card bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 hover:shadow-md transition-all flex flex-col" data-category="hypermarket" data-cities="riyadh,dammam">
                    <div class="relative bg-gradient-to-r from-red-600 to-rose-700 p-4 text-white">
                        <span class="absolute top-3 right-3 bg-yellow-300 text-slate-900 text-[10px] font-bold px-2 py-0.5 rounded-full shadow">WEEKEND FLASH</span>
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-red-600 font-extrabold text-lg shadow">
                                🏬
                            </div>
                            <div>
                                <h3 class="font-bold text-lg">Nesto Hypermarket</h3>
                                <p class="text-xs text-red-100"><i class="fa-regular fa-clock me-1"></i> Valid 4 Days Only</p>
