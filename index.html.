                        </div>
                        <button onclick="openLeafletModal('Nesto Weekend Special Flyer', 4, 'Nesto')" class="w-full bg-slate-900 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Browse Leaflet
