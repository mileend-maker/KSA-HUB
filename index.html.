<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saudi Expat & Driver Utility Hub</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        saudi: {
                            green: '#006C35',
                            gold: '#C5A059',
                            dark: '#0A1E14',
                            light: '#F0F7F4'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        arabic: ['Tajawal', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        .arabic-text {
            font-family: 'Tajawal', sans-serif;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
            animation: fadeIn 0.25s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col pb-20 md:pb-6">

    <!-- Top Ad Arbitrage & Platform Status Bar -->
    <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4">
        <div class="max-w-7xl mx-mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 bg-emerald-950 text-emerald-400 border border-emerald-800/50 px-2 py-0.5 rounded-full font-mono text-[11px]">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE PLATFORM
                </span>
                <span class="hidden sm:inline text-slate-400">SAR / ER API Status: <strong class="text-emerald-400">100% Online</strong></span>
            </div>
            <div class="flex items-center gap-4 text-[11px]">
                <span class="text-amber-400 font-semibold"><i class="fa-solid me-1 fa-chart-line"></i> Daily RPM: <span id="rpmCounter">SAR 14.80</span></span>
                <button onclick="shareAppOnWhatsApp()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-0.5 rounded font-medium transition-all flex items-center gap-1">
                    <i class="fa-brands fa-whatsapp text-xs"></i> Share Hub
                </button>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="bg-gradient-to-r from-saudi-dark via-emerald-950 to-slate-900 text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-saudi-green flex items-center justify-center text-white shadow-lg border border-emerald-400/30">
                    <i class="fa-solid fa-kaaba text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-tight flex items-center gap-2">
                        KSA Expat & Driver Hub
                        <span class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] uppercase font-bold px-1.5 py-0.5 rounded">v3.0</span>
                    </h1>
                    <p class="text-xs text-emerald-200/80">Saudi Arabia Daily Utility & Operations Platform</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <div class="text-right hidden sm:block">
                    <p class="text-[11px] text-slate-400">Riyadh, KSA</p>
                    <p class="text-xs font-semibold text-emerald-300" id="liveClock">--:--:-- SAR</p>
                </div>
            </div>
        </div>

        <!-- Sticky Desktop & Tablet Tab Navigation Bar -->
        <nav class="bg-slate-900/95 backdrop-blur-md border-t border-slate-800 text-slate-300 text-xs overflow-x-auto">
            <div class="max-w-7xl mx-auto px-2 flex whitespace-nowrap scrollbar-none">
                <button onclick="switchTab('deals')" id="nav-deals" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-emerald-500 text-emerald-400 transition-all hover:text-white">
                    <i class="fa-solid fa-store text-sm"></i>
                    <span>Weekly Deals</span>
                    <span class="bg-red-500 text-white text-[9px] px-1.5 py-0.2 rounded-full font-bold uppercase">Hot</span>
                </button>
                <button onclick="switchTab('remittance')" id="nav-remittance" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-transparent text-slate-400 transition-all hover:text-white">
                    <i class="fa-solid fa-money-bill-transfer text-sm"></i>
                    <span>Live Remittance</span>
                </button>
                <button onclick="switchTab('dallah')" id="nav-dallah" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-transparent text-slate-400 transition-all hover:text-white">
                    <i class="fa-solid fa-id-card text-sm"></i>
                    <span>Dallah Driving Exam</span>
                </button>
                <button onclick="switchTab('calculators')" id="nav-calculators" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-transparent text-slate-400 transition-all hover:text-white">
                    <i class="fa-solid fa-calculator text-sm"></i>
                    <span>EOSB & Fuel Calc</span>
                </button>
                <button onclick="switchTab('arabic')" id="nav-arabic" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-transparent text-slate-400 transition-all hover:text-white">
                    <i class="fa-solid fa-comments text-sm"></i>
                    <span>Survival Arabic</span>
                </button>
                <button onclick="switchTab('directory')" id="nav-directory" class="nav-tab px-4 py-3 font-semibold flex items-center gap-2 border-b-2 border-transparent text-slate-400 transition-all hover:text-white">
                    <i class="fa-solid fa-building-columns text-sm"></i>
                    <span>KSA Directory</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full">

        <!-- ========================================== -->
        <!-- SECTION 1: WEEKLY DEALS & FLYERS (CLICKFLYER) -->
        <!-- ========================================== -->
        <section id="tab-deals" class="tab-content active space-y-6">
            
