        async function fetchLiveRemittanceRates() {
            try {
                const response = await fetch('https://open.er-api.com/v6/latest/SAR');
                if (response.ok) {
                    const data = await response.json();
                    if (data && data.rates) {
                        liveRatesData.INR = data.rates.INR || liveRatesData.INR;
                        liveRatesData.PKR = data.rates.PKR || liveRatesData.PKR;
                        liveRatesData.BDT = data.rates.BDT || liveRatesData.BDT;
                        liveRatesData.NPR = data.rates.NPR || liveRatesData.NPR;
                        liveRatesData.LKR = data.rates.LKR || liveRatesData.LKR;
                        liveRatesData.PHP = data.rates.PHP || liveRatesData.PHP;
                        liveRatesData.EGP = data.rates.EGP || liveRatesData.EGP;
                    }
                }
            } catch (err) {
                console.log("Using cached fallback rate data.");
            }
            calculateRemittance();
        }

        function calculateRemittance() {
            const amount = parseFloat(document.getElementById('remitAmount').value) || 1000;
            const targetCurr = document.getElementById('targetCurrency').value;
            const baseRate = liveRatesData[targetCurr] || 20.0;

            document.getElementById('liveInterbankDisplay').innerText = `${baseRate.toFixed(2)} ${targetCurr}`;

            const grid = document.getElementById('remitCardsGrid');
            const tableBody = document.getElementById('remitTableBody');

            grid.innerHTML = '';
            tableBody.innerHTML = '';

            let topPayout = 0;
            let bestProviderId = '';

            // Calculate payouts for all providers
            const results = providersList.map(prov => {
                const feeSAR = prov.baseFee;
                const vatSAR = feeSAR * (prov.vatPercent / 100);
                const effectiveSARToTransfer = Math.max(0, amount - feeSAR - vatSAR);
                
                // Exchange rate margin spread applied
                const effectiveRate = baseRate * (1 - prov.spreadMargin);
                const netPayoutHome = effectiveSARToTransfer * effectiveRate;

                if (netPayoutHome > topPayout) {
                    topPayout = netPayoutHome;
                    bestProviderId = prov.id;
                }

                return {
                    ...prov,
                    feeSAR,
                    vatSAR,
                    effectiveRate,
                    netPayoutHome
                };
            });

            // Render Dynamic Cards
            results.forEach(res => {
                const isBest = (res.id === bestProviderId);
                
                // Render Card
                const cardHtml = `
                    <div class="bg-white rounded-2xl p-4 border ${isBest ? 'border-2 border-emerald-500 shadow-md ring-2 ring-emerald-500/20' : 'border-slate-200'} space-y-3 flex flex-col justify-between relative">
                        ${isBest ? `<span class="absolute -top-3 left-4 bg-emerald-600 text-white text-[9px] font-extrabold uppercase px-2.5 py-0.5 rounded-full shadow">Highest Payout</span>` : ''}
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-xl">${res.logo}</span>
                                    <h4 class="font-bold text-slate-800 text-sm">${res.name}</h4>
                                </div>
                                <span class="text-xs text-slate-500 font-semibold">${res.rating}</span>
                            </div>

                            <div class="bg-slate-50 p-2.5 rounded-xl border space-y-1 text-xs">
                                <div class="flex justify-between text-slate-600">
                                    <span>Applied Rate:</span>
                                    <strong class="text-slate-800">1 SAR = ${res.effectiveRate.toFixed(2)} ${targetCurr}</strong>
                                </div>
                                <div class="flex justify-between text-slate-600">
                                    <span>Transfer Fee:</span>
                                    <span>${res.feeSAR.toFixed(2)} SAR</span>
                                </div>
                                <div class="flex justify-between text-slate-600">
                                    <span>15% KSA VAT:</span>
                                    <span>${res.vatSAR.toFixed(2)} SAR</span>
                                </div>
                            </div>
                        </div>

                        <div class="border-t pt-2 flex justify-between items-end">
                            <div>
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Net Home Payout</span>
                                <span class="text-lg font-extrabold text-emerald-700">${res.netPayoutHome.toLocaleString(undefined, {maximumFractionDigits:2})} ${targetCurr}</span>
                            </div>
                            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-1 rounded font-semibold">${res.speed}</span>
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHtml;

                // Render Table Row
                const rowHtml = `
                    <tr class="${isBest ? 'bg-emerald-50/60 font-semibold' : ''}">
                        <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                            <span>${res.logo}</span> ${res.name}
                        </td>
                        <td class="p-3">1 SAR = ${res.effectiveRate.toFixed(2)}</td>
                        <td class="p-3">${res.feeSAR.toFixed(2)} SAR</td>
                        <td class="p-3">${res.vatSAR.toFixed(2)} SAR</td>
                        <td class="p-3 text-slate-500">${res.speed}</td>
                        <td class="p-3 text-right font-extrabold ${isBest ? 'text-emerald-700' : 'text-slate-800'}">
                            ${res.netPayoutHome.toLocaleString(undefined, {maximumFractionDigits:2})} ${targetCurr}
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += rowHtml;
            });
        }

        // -------------------------------------------------------------
        // SECTION 3: Dallah Driving Exam Simulator Logic
        // -------------------------------------------------------------
        function initDallahExam() {
            examState.currentIdx = 0;
            examState.userAnswers = {};
            examState.score = 0;
            renderQuestionGridPalette();
            renderCurrentQuestion();
        }

        function setExamMode(mode) {
            examState.mode = mode;
            const btnP = document.getElementById('btnModePractice');
            const btnT = document.getElementById('btnModeTimed');

            if (mode === 'practice') {
                btnP.className = "px-3 py-1.5 rounded-lg bg-white shadow text-slate-800 font-bold";
                btnT.className = "px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900";
                clearInterval(examState.timerInterval);
                document.getElementById('timerDisplay').innerText = "Unlimited";
            } else {
                btnT.className = "px-3 py-1.5 rounded-lg bg-white shadow text-slate-800 font-bold";
                btnP.className = "px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900";
                startTimer();
            }
        }

        function startTimer() {
            clearInterval(examState.timerInterval);
            examState.secondsLeft = 1800; // 30 minutes
            examState.timerInterval = setInterval(() => {
                examState.secondsLeft--;
                const mins = Math.floor(examState.secondsLeft / 60);
                const secs = examState.secondsLeft % 60;
                document.getElementById('timerDisplay').innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;

                if (examState.secondsLeft <= 0) {
                    clearInterval(examState.timerInterval);
                    alert("Time limit expired! Submitting exam results.");
                }
            }, 1000);
        }

        function renderQuestionGridPalette() {
            const container = document.getElementById('questionGridPalette');
            container.innerHTML = '';

            dallahQuestions.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${idx === examState.currentIdx ? 'bg-emerald-600 text-white ring-2 ring-emerald-400' : 'bg-white border text-slate-700 hover:bg-slate-100'}`;
                btn.innerText = idx + 1;
                btn.onclick = () => jumpToQuestion(idx);
                btn.id = `palette-btn-${idx}`;
                container.appendChild(btn);
            });

            document.getElementById('totalQNum').innerText = dallahQuestions.length;
        }

        function renderCurrentQuestion() {
            const q = dallahQuestions[examState.currentIdx];
            document.getElementById('currentQNum').innerText = examState.currentIdx + 1;
            document.getElementById('qCategory').innerText = `Category: ${q.category}`;
            document.getElementById('qText').innerText = q.text;

            // Render Sign SVG Graphic
            const signContainer = document.getElementById('qSignGraphic');
            signContainer.innerHTML = `
                <div class="w-24 h-24 rounded-2xl bg-slate-800 border-2 border-amber-400/40 flex flex-col items-center justify-center text-amber-400 shadow-inner p-2 text-center">
                    <i class="fa-solid fa-triangle-exclamation text-3xl mb-1"></i>
                    <span class="text-[9px] font-bold uppercase tracking-tighter">KSA Road Sign</span>
                </div>
            `;

            // Render Option Buttons
            const optionsBox = document.getElementById('optionsContainer');
            optionsBox.innerHTML = '';

            const answered = examState.userAnswers.hasOwnProperty(examState.currentIdx);
            const selectedOpt = examState.userAnswers[examState.currentIdx];

            q.options.forEach((optText, optIdx) => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-3.5 rounded-xl border transition-all text-xs font-semibold flex items-center justify-between ${answered ? (optIdx === q.correct ? 'bg-emerald-800/80 border-emerald-500 text-white' : (optIdx === selectedOpt ? 'bg-red-900/80 border-red-500 text-white' : 'bg-slate-800/50 border-slate-700 text-slate-400')) : 'bg-slate-800 border-slate-700 text-slate-200 hover:bg-slate-700'}`;
                
                btn.innerHTML = `
                    <span>${String.fromCharCode(65 + optIdx)}. ${optText}</span>
                    ${answered && optIdx === q.correct ? '<i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>' : ''}
                `;

                btn.disabled = answered;
                btn.onclick = () => selectOption(optIdx);
                optionsBox.appendChild(btn);
            });

            // Explanation Banner
            const expBanner = document.getElementById('explanationBanner');
            if (answered) {
                expBanner.classList.remove('hidden');
                expBanner.className = `p-4 rounded-xl text-xs space-y-1 transition-all ${selectedOpt === q.correct ? 'bg-emerald-950 border border-emerald-800 text-emerald-200' : 'bg-red-950 border border-red-800 text-red-200'}`;
                document.getElementById('explanationTitle').innerText = selectedOpt === q.correct ? "✓ Correct Answer!" : "✕ Incorrect Answer";
                document.getElementById('explanationText').innerText = q.explanation;
            } else {
                expBanner.classList.add('hidden');
            }

            // Update Palette status
            renderQuestionGridPalette();
        }

        function selectOption(optIdx) {
            if (examState.userAnswers.hasOwnProperty(examState.currentIdx)) return;

            examState.userAnswers[examState.currentIdx] = optIdx;
            const q = dallahQuestions[examState.currentIdx];

            if (optIdx === q.correct) {
                examState.score++;
            }

            document.getElementById('scoreDisplay').innerText = `${examState.score} Correct`;
            renderCurrentQuestion();
        }

        function jumpToQuestion(idx) {
            examState.currentIdx = idx;
            renderCurrentQuestion();
        }

        function prevQuestion() {
            if (examState.currentIdx > 0) {
                examState.currentIdx--;
                renderCurrentQuestion();
            }
        }

        function nextQuestion() {
            if (examState.currentIdx < dallahQuestions.length - 1) {
                examState.currentIdx++;
                renderCurrentQuestion();
            }
        }

        // Web Speech TTS Reader for Questions
        function speakCurrentQuestion() {
            const q = dallahQuestions[examState.currentIdx];
            const lang = document.getElementById('ttsLang').value;

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const msg = new SpeechSynthesisUtterance(q.text);
                msg.lang = lang === 'hi' ? 'hi-IN' : (lang === 'ur' ? 'ur-PK' : (lang === 'bn' ? 'bn-BD' : 'en-US'));
                window.speechSynthesis.speak(msg);
            }
        }

        // -------------------------------------------------------------
        // SECTION 4: EOSB & Fuel Calculator Logic
        // -------------------------------------------------------------
        function calculateEOSB() {
            const lawType = document.getElementById('eosbLawType').value;
            const salary = parseFloat(document.getElementById('eosbSalary').value) || 0;
            const years = parseInt(document.getElementById('eosbYears').value) || 0;
            const months = parseInt(document.getElementById('eosbMonths').value) || 0;
            const reason = document.getElementById('eosbReason').value;

            const totalYears = years + (months / 12);
            let eosbAmount = 0;
            let noteText = '';

            if (lawType === 'article22') {
                // Article 22 Domestic Workers Law: 1 month salary for every 4 consecutive years
                document.getElementById('eosbReasonContainer').style.display = 'none';
                
                const fourYearCycles = Math.floor(totalYears / 4);
                eosbAmount = fourYearCycles * salary;
                noteText = "Article 22 Rules: Domestic House Drivers are entitled to 1 full month salary for every 4 completed consecutive years of service. (0 SAR if service is under 4 years).";
            } else {
                // Article 84 Standard Labor Law
                document.getElementById('eosbReasonContainer').style.display = 'block';

                let baseEosb = 0;
                if (totalYears <= 5) {
                    baseEosb = totalYears * (salary * 0.5);
                } else {
                    baseEosb = (5 * (salary * 0.5)) + ((totalYears - 5) * salary);
                }

                // Resignation multipliers
                if (reason === 'resignation') {
                    if (totalYears < 2) {
                        eosbAmount = 0;
                    } else if (totalYears >= 2 && totalYears < 5) {
                        eosbAmount = baseEosb * (1/3);
                    } else if (totalYears >= 5 && totalYears < 10) {
                        eosbAmount = baseEosb * (2/3);
                    } else {
                        eosbAmount = baseEosb;
                    }
                } else {
                    eosbAmount = baseEosb;
                }

                noteText = "Article 84 Rules: Half month salary per year for first 5 years, full month per year thereafter.";
            }

            document.getElementById('eosbResultAmount').innerText = `${eosbAmount.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})} SAR`;
            document.getElementById('eosbNote').innerText = noteText;
        }

        function calculateFuel() {
            const fuelPrice = parseFloat(document.getElementById('fuelType').value) || 2.18;
            const efficiency = parseFloat(document.getElementById('fuelEfficiency').value) || 10.0;
            const distance = parseFloat(document.getElementById('fuelDistance').value) || 300;

            document.getElementById('distanceValue').innerText = `${distance} km`;

            const litersNeeded = distance / efficiency;
            const tripCost = litersNeeded * fuelPrice;
            const monthlyCost = tripCost * 30;

            document.getElementById('fuelLiters').innerText = `${litersNeeded.toFixed(1)} L`;
            document.getElementById('fuelTripCost').innerText = `${tripCost.toFixed(2)} SAR`;
            document.getElementById('fuelMonthlyCost').innerText = `${monthlyCost.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})} SAR`;
        }

        // -------------------------------------------------------------
        // SECTION 5: Survival Arabic Audio Soundboard Logic
        // -------------------------------------------------------------
        function renderArabicPhrases() {
            const grid = document.getElementById('arabicPhraseGrid');
            grid.innerHTML = '';

            arabicPhrases.forEach((p, idx) => {
                const cardHtml = `
                    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm hover:border-emerald-500 hover:shadow-md transition-all flex flex-col justify-between space-y-3">
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold uppercase text-slate-400 bg-slate-100 px-2 py-0.5 rounded">${p.cat}</span>
                                <button onclick="playArabicAudio('${p.ar.replace(/'/g, "\\'")}')" class="w-8 h-8 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center transition-all shadow">
                                    <i class="fa-solid fa-volume-high text-xs"></i>
                                </button>
                            </div>
                            <h4 class="font-bold text-slate-800 text-sm mb-1">${p.title}</h4>
                            <p class="arabic-text text-xl font-bold text-emerald-700 text-right my-2" dir="rtl">${p.ar}</p>
                            <p class="text-xs font-semibold text-amber-700 italic">"${p.trans}"</p>
                        </div>
                        <div class="border-t pt-2 text-[11px] text-slate-500 flex justify-between items-center">
                            <span>Meaning: <strong>${p.meaning}</strong></span>
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHtml;
            });
        }

        function playArabicAudio(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const msg = new SpeechSynthesisUtterance(text);
                msg.lang = 'ar-SA';
                msg.rate = 0.9;
                window.speechSynthesis.speak(msg);
            }
        }
    </script>
