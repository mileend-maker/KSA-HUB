                            <p class="text-[11px] text-slate-500 bg-slate-50 p-2 rounded border">Special discounts on South Asian & Asian spices, basmati rice & fresh meats.</p>
                        </div>
                        <button onclick="openLeafletModal('LuLu World Food Festival', 4, 'LuLu')" class="w-full bg-slate-900 hover:bg-emerald-700 text-white py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Browse Leaflet
                        </button>
