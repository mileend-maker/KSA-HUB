                            <option value="riyadh" selected>Riyadh (الرياض)</option>
                            <option value="jeddah">Jeddah (جدة)</option>
                            <option value="dammam">Dammam / Khobar (الدمام)</option>
                            <option value="makkah">Makkah & Madinah</option>
