                </div>

                <!-- Carrefour KSA Card -->
                <div class="flyer-card bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 hover:shadow-md transition-all flex flex-col" data-category="hypermarket" data-cities="riyadh,jeddah font-sans">
                    <div class="relative bg-gradient-to-r from-blue-600 to-indigo-700 p-4 text-white">
